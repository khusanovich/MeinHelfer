# Copy this file to .env and fill in all values before starting.
# Never commit .env to version control.
#
# Generate SECRET_KEY with:  openssl rand -hex 32

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=meinhelfer
POSTGRES_USER=meinhelfer
POSTGRES_PASSWORD=change_me_strong_password

# ── Backend security ──────────────────────────────────────────────────────────
SECRET_KEY=change_me_64_chars_minimum_use_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_HOURS=8

# ── SMTP (email notifications) ────────────────────────────────────────────────
# Leave SMTP_HOST empty to disable emails (logs will show what would be sent).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@meinhelfer.de
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM=noreply@meinhelfer.de
SMTP_FROM_NAME=MeinHelfer
SMTP_TLS=true

# ── Notifications ─────────────────────────────────────────────────────────────
# Admin email that receives new-request alerts
ADMIN_EMAIL=owner@meinhelfer.de

# ── Production only (ignored in development) ──────────────────────────────────
DOMAIN=meinhelfer.de
ACME_EMAIL=owner@meinhelfer.de
APP_URL=https://meinhelfer.de
