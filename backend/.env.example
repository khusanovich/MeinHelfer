# PostgreSQL Database
POSTGRES_DB=meinhelfer
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
DATABASE_URL=postgresql+asyncpg://postgres:your_secure_password_here@localhost:5432/meinhelfer

# Security
SECRET_KEY=your_secret_key_here_use_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_HOURS=8

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@mein-helfer.de
SMTP_FROM_NAME=MeinHelfer
SMTP_TLS=true

# Admin
ADMIN_EMAIL=admin@mein-helfer.de

# Domain & SSL
DOMAIN=mein-helfer.de
ACME_EMAIL=admin@mein-helfer.de
APP_URL=https://mein-helfer.de

# Environment
ENVIRONMENT=production

# CORS - Frontend URLs
CORS_ORIGINS=["https://mein-helfer.de","https://www.mein-helfer.de"]
